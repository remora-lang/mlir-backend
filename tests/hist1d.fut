-- ==
-- input {
--   [0i64, 1i64, 1i64, 3i64, 1i64]
--   [10i32, 1i32, 2i32, 5i32, 3i32]
-- }
-- output { [10i32, 6i32, 0i32, 5i32] }
-- ==
-- input {
--   [2i64, 2i64, 0i64, 2i64]
--   [1i32, 1i32, 4i32, 1i32]
-- }
-- output { [4i32, 0i32, 3i32, 0i32] }
def main [n] (is: [n]i64) (vs: [n]i32) : [4]i32 =
  hist (+) 0 4 is vs
